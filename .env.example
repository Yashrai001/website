# ==========================================
# Hotel Luxe - Production Environment Variables
# ==========================================

# 1. Admin Dashboard Password (Required for /admin access)
# Set a strong password for your production admin dashboard.
ADMIN_PASSWORD=your_secure_admin_password_here

# 2. Public Site Canonical URL (Optional)
# If left unset, the site will automatically use the Vercel production URL (https://<your-project>.vercel.app)
NEXT_PUBLIC_SITE_URL=https://hotelluxe.vercel.app

# 3. Future External Database Configuration (Optional)
# If connecting an external database such as Supabase, Neon, or Postgres:
# DATABASE_URL=postgresql://user:password@hostname:5432/hotelluxe

# 4. Email Notification Service (Optional)
# If connecting transactional emails for enquiries via Resend / SendGrid:
# RESEND_API_KEY=re_123456789
